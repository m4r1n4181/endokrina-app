# ============================================================
# DEV-001 Thyroid Pre-Visit Platform — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# All production secrets must be set in the hosting environment.
# Data residency / AWS region is a config value — never hardcode.

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Required. Postgres connection string.
# For Replit: this is set automatically by the DB integration.
DATABASE_URL=postgresql://user:pass@localhost:5432/thyroid_dev

# ── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Generate with: openssl rand -hex 64
MAGIC_LINK_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
MAGIC_LINK_EXPIRES_DAYS=365

# ── Patient identity verification ─────────────────────────────
DOB_MAX_ATTEMPTS=5
DOB_BLOCK_MINUTES=30
OTP_MAX_ATTEMPTS=5
OTP_BLOCK_MINUTES=30
OTP_EXPIRES_MINUTES=10

# ── SMS OTP ───────────────────────────────────────────────────
# "stub" logs OTP to console (dev/Stage 0 only — never for real patient data)
# "twilio" or "aws_sns" for production
SMS_PROVIDER=stub
SMS_FROM_NUMBER=
# Twilio (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# AWS SNS (only if SMS_PROVIDER=aws_sns)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── File storage ──────────────────────────────────────────────
# "stub" = local temporary file storage
# "s3" = S3 or LocalStack object storage
STORAGE_PROVIDER=stub
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
STORAGE_BUCKET=
# 20 MB default
MAX_UPLOAD_SIZE_BYTES=20971520

# ── Email ─────────────────────────────────────────────────────
# "stub" logs the message to the API console (dev/Stage 0, dummy data only)
# "smtp" sends for real via nodemailer. Amazon SES works through its SMTP endpoint
#        (host email-smtp.<region>.amazonaws.com, SMTP credentials from the SES console).
# In production TLS is mandatory: use port 465 (implicit TLS) or 587 (STARTTLS).
# For local testing without TLS use a sink such as Mailpit: SMTP_HOST=localhost SMTP_PORT=1025
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@thyroid-clinic.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Doctor morning briefing ───────────────────────────────────
# One email per doctor per day, only on days with appointments (clinic-local time, APP_TIMEZONE).
# Sent at the first job tick at/after MORNING_BRIEFING_HOUR; if the server was down then,
# it still catches up until MORNING_BRIEFING_HOUR + MORNING_BRIEFING_CATCHUP_HOURS.
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_CATCHUP_HOURS=5

# ── Lab freshness ─────────────────────────────────────────────
LAB_FRESHNESS_THRESHOLD_DAYS=90

# ── Questionnaire locking ─────────────────────────────────────
QUESTIONNAIRE_LOCK_STRATEGY=appointment_start
QUESTIONNAIRE_LOCK_OFFSET_MINUTES=0

# ── Retention ─────────────────────────────────────────────────
# Company-configurable; not hardcoded per clinic (per compliance)
DOCUMENT_RETENTION_DAYS=365
# Questionnaire answers: retained long-term (no deletion)
# Audit logs: retained always (no deletion job — by legal requirement)

# ── App URL (API) ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:5000

# ── Portal URL (frontend — magic links open here) ─────────────
PORTAL_BASE_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=*
