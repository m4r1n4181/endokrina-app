# Local development — Stage 0
# Copy to .env and fill in the required credentials. Never commit .env.
# Generate secrets with: openssl rand -hex 64

NODE_ENV=development
PORT=5000

# Required PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/thyroid_dev

# Required: each secret must be at least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRES_DAYS=30

DOB_MAX_ATTEMPTS=5
DOB_BLOCK_MINUTES=30
OTP_MAX_ATTEMPTS=5
OTP_BLOCK_MINUTES=30
OTP_EXPIRES_MINUTES=10

# SMS: stub logs codes locally; supported values are stub, twilio, aws_sns
SMS_PROVIDER=stub
SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email: smtp.resend.com uses implicit TLS on port 465
EMAIL_PROVIDER=smtp
# Replace with a sender address verified by your email provider
EMAIL_FROM=notifications@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Storage: s3 requires a bucket; use stub for local filesystem storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=endokrina-docs
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uncomment and set only when using an S3-compatible endpoint such as LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566
MAX_UPLOAD_SIZE_BYTES=20971520

LAB_FRESHNESS_THRESHOLD_DAYS=90
QUESTIONNAIRE_LOCK_STRATEGY=appointment_start
QUESTIONNAIRE_LOCK_OFFSET_MINUTES=0
DOCUMENT_RETENTION_DAYS=365

APP_BASE_URL=http://localhost:5000
PORTAL_BASE_URL=http://localhost:5173
# * is suitable only for local development; use explicit origins in production
CORS_ORIGINS=*

JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60
REMINDER_HOURS_BEFORE=24
APP_TIMEZONE=Europe/Belgrade
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_CATCHUP_HOURS=24
